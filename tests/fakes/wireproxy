#!/usr/bin/env python3
"""Stand-in for wireproxy in tests: a SOCKS5 server that answers any HTTP GET with a fake IP."""
import socketserver, struct, sys

conf = open(sys.argv[sys.argv.index("-c") + 1]).read()
kv = dict(l.split(" = ", 1) for l in conf.splitlines() if " = " in l)
host, port = kv["BindAddress"].rsplit(":", 1)
user, password = kv.get("Username", ""), kv.get("Password", "")
if "FAIL" in kv["WGConfig"]:
    print("simulated failure", flush=True)
    sys.exit(3)

DEAD = "DEAD" in kv["WGConfig"]  # simulate a tunnel whose handshake never completes

class H(socketserver.BaseRequestHandler):
    def handle(self):
        s = self.request
        if DEAD:
            return
        n = s.recv(2)[1]; methods = s.recv(n)
        if user:
            s.sendall(b"\x05\x02"); s.recv(1)
            u = s.recv(s.recv(1)[0]).decode(); p = s.recv(s.recv(1)[0]).decode()
            if (u, p) != (user, password):
                s.sendall(b"\x01\x01"); return
            s.sendall(b"\x01\x00")
        else:
            s.sendall(b"\x05\x00")
        s.recv(4); s.recv(s.recv(1)[0] + 2)
        s.sendall(b"\x05\x00\x00\x01" + bytes(4) + struct.pack(">H", 0))
        s.recv(4096)
        ip = f"203.0.113.{int(port) % 250}"
        s.sendall(f"HTTP/1.1 200 OK\r\nContent-Length: {len(ip)}\r\n\r\n{ip}".encode())

socketserver.ThreadingTCPServer.allow_reuse_address = True
print(f"listening {host}:{port}", flush=True)
socketserver.ThreadingTCPServer((host, int(port)), H).serve_forever()
