# ---------------------------------------------------------------------------
# lanepool configuration. Copy to .env and edit:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Surfshark -------------------------------------------------------------
# Surfshark dashboard -> VPN -> Manual setup -> Router (or Desktop) -> WireGuard
# -> "I don't have a key pair" -> Generate. Paste the PRIVATE key here.
# Leave empty to only use .conf files from ./configs.
SURFSHARK_PRIVATE_KEY=

# How many lanes (exit IPs) to run. Surfshark has ~140 locations in ~100 countries.
# If you change this, update the lane port range in docker-compose.yml too.
LANES=99

# Optional filters (comma separated ISO country codes, lowercase or uppercase).
# COUNTRIES=us,gb,de,fr,nl
# EXCLUDE_COUNTRIES=ru,cn
# Set to false to skip "virtual" locations (servers physically hosted elsewhere).
# INCLUDE_VIRTUAL=true

# Or pin exact locations, in order (lane 0 = first entry). Overrides the filters.
# Names are the first part of the Surfshark hostname, e.g. us-nyc, de-fra, uk-lon.
# SURFSHARK_LOCATIONS=us-nyc,us-lax,de-fra,uk-lon,nl-ams

# --- Proxy -----------------------------------------------------------------
# Host IP the ports are published on. 127.0.0.1 = only this machine.
# Use 0.0.0.0 to reach it from other machines; then ALSO set PROXY_USER/PROXY_PASS
# and firewall the ports, or anyone can use your VPN account.
BIND_IP=127.0.0.1

# Rotating proxy port (speaks both HTTP and SOCKS5).
PROXY_PORT=8080

# Proxy authentication, applied to the rotating proxy, every lane port and the
# dashboard. No spaces. Leave both empty to disable.
PROXY_USER=
PROXY_PASS=

# How the rotating proxy picks a lane:
#   rr  - round robin, every new connection uses the next lane (default)
#   dh  - destination hash, the same target host always uses the same lane
#   ha  - always use the first healthy lane (failover only)
#   lha - lowest-latency healthy lane
STRATEGY=rr

# Health check the rotating proxy runs through each lane; unhealthy lanes are skipped.
# CHECK_URL=http://www.msftconnecttest.com/connecttest.txt#expect=200
# CHECK_INTERVAL=30
# MAX_FAILURES=3

# --- Dashboard / API ---------------------------------------------------------
API_PORT=8000
# How often (seconds) each lane's public exit IP is looked up. 0 disables.
IP_CHECK_INTERVAL=600
# Must be plain http:// and return just the IP.
# IP_CHECK_URL=http://api.ipify.org/

# --- Advanced --------------------------------------------------------------
# LANE_PORT_START=10001
# LANE_LOGS=false        # true = print every wireproxy's output to the container log
# LOG_LEVEL=INFO
