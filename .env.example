# ---------------------------------------------------------------------------
# lanepool v2. Copy to .env and fill in the three secrets:
#   cp .env.example .env
# Everything else is configured in the dashboard.
# ---------------------------------------------------------------------------

# Encrypts VPN keys and alert secrets stored in the database. Keep it safe:
# changing it makes stored keys unreadable. Generate: openssl rand -hex 32
LANEPOOL_SECRET=

# Shared secret between control and engine. Generate: openssl rand -hex 24
ENGINE_TOKEN=

# Postgres password (docker compose creates the database).
POSTGRES_PASSWORD=

# Optional: create the first dashboard admin automatically. Otherwise the
# dashboard asks you to create one on first visit.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false

# Host IP the dashboard (8000) and proxy (8080) ports are published on.
# 127.0.0.1 = this machine only.
BIND_IP=127.0.0.1

# When a reverse proxy (e.g. Traefik) sends PROXY protocol headers to the engine,
# list its addresses here so logs show real client IPs. Comma separated CIDRs.
# TRUSTED_PROXIES=10.0.1.0/24

# LOG_LEVEL=info

# --- One-time import (optional) ------------------------------------------------
# On first start with an empty database these are imported, so a v1 setup keeps
# working. Afterwards, manage everything in the dashboard.
# SURFSHARK_PRIVATE_KEYS=key1,key2
# LANES=20
# COUNTRIES=us,de
# PROXY_USER=myuser
# PROXY_PASS=a-long-password
# PUBLIC_PROXY_HOST=proxy.example.com
